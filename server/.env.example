# --- Core ---
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/preorder
JWT_SECRET=change-me-to-a-long-random-string
# Where the React app is served from (for CORS)
WEB_ORIGIN=http://localhost:5173
# Public URL of THIS API, used for M-Pesa callbacks (must be https in production)
PUBLIC_API_URL=https://your-api-domain.com

# First admin account (created by `npm run seed`). Log in with this phone number.
ADMIN_PHONE=0700000000
ADMIN_NAME=Admin

# Business details shown to customers
BUSINESS_NAME=Preorder Shop
SHOP_LOCATION=our Nairobi shop
PAYBILL_NUMBER=000000
# Fee added to the order when a customer chooses delivery instead of pickup (0 = free delivery)
DELIVERY_FEE_KES=0
# Text shown on the storefront banner
STORE_HEADLINE=Preorder now. Collect when it lands.
STORE_TAGLINE=Pay with M-Pesa, follow your order by SMS, and pick it up with a code.

# --- SMS: Africa's Talking ---
# SMS_PROVIDER=console prints SMS to the server log (for development; OTP is also shown on the login screen)
# SMS_PROVIDER=africastalking sends real SMS
SMS_PROVIDER=console
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
# Set to true when using the Africa's Talking sandbox
AT_SANDBOX=true

# --- M-Pesa Daraja ---
# MPESA_MODE=mock simulates a successful STK payment a few seconds after the request (development)
# MPESA_MODE=sandbox | production uses the real Daraja API
MPESA_MODE=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# CustomerPayBillOnline for Paybill, CustomerBuyGoodsOnline for Till
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Random secret added to callback URLs so outsiders can't fake payment callbacks
MPESA_CALLBACK_SECRET=change-me-too
